# ===================================================================
# Firebase Configuration Files
# ===================================================================
# IMPORTANTE: NÃO ignorar arquivos de configuração do Firebase
# Eles devem ser commitados no repositório
#
# Arquivos que DEVEM ser commitados:
# - google-services.json (Android)
# - GoogleService-Info.plist (iOS)
# - lib/firebase_options.dart (gerado pelo FlutterFire CLI)
#
# Descomentar apenas se usar variáveis de ambiente para config:
# google-services.json
# GoogleService-Info.plist
# lib/firebase_options.dart

